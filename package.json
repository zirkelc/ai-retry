{
  "name": "ai-retry",
  "version": "2.4.0",
  "description": "Retry and fallback mechanisms for AI SDK",
  "keywords": [
    "ai",
    "ai-sdk",
    "fallback",
    "retry"
  ],
  "license": "MIT",
  "author": "Chris Cook",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zirkelc/ai-retry.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": "./dist/index.mjs",
    "./embed": "./dist/call/embed/index.mjs",
    "./embed/conditions": "./dist/call/embed/conditions/index.mjs",
    "./embed-many": "./dist/call/embed-many/index.mjs",
    "./embed-many/conditions": "./dist/call/embed-many/conditions/index.mjs",
    "./embedding-model": "./dist/model/embedding-model/index.mjs",
    "./embedding-model/conditions": "./dist/model/embedding-model/conditions/index.mjs",
    "./experimental/call": "./dist/experimental/call/index.mjs",
    "./experimental/stream": "./dist/experimental/stream/index.mjs",
    "./generate-image": "./dist/call/generate-image/index.mjs",
    "./generate-image/conditions": "./dist/call/generate-image/conditions/index.mjs",
    "./generate-text": "./dist/call/generate-text/index.mjs",
    "./generate-text/conditions": "./dist/call/generate-text/conditions/index.mjs",
    "./image-model": "./dist/model/image-model/index.mjs",
    "./image-model/conditions": "./dist/model/image-model/conditions/index.mjs",
    "./language-model": "./dist/model/language-model/index.mjs",
    "./language-model/conditions": "./dist/model/language-model/conditions/index.mjs",
    "./retryables": "./dist/retryables/index.mjs",
    "./stream-text": "./dist/call/stream-text/index.mjs",
    "./stream-text/conditions": "./dist/call/stream-text/conditions/index.mjs",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "prepublishOnly": "pnpm build && pnpm typecheck",
    "build": "tsdown",
    "test": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint --fix",
    "lint:ci": "oxlint",
    "format": "oxfmt --write",
    "format:ci": "oxfmt --check",
    "prepare": "husky"
  },
  "devDependencies": {
    "@ai-sdk/anthropic": "4.0.18",
    "@ai-sdk/azure": "4.0.19",
    "@ai-sdk/gateway": "4.0.27",
    "@ai-sdk/google": "4.0.22",
    "@ai-sdk/groq": "4.0.13",
    "@ai-sdk/openai": "4.0.18",
    "@ai-sdk/otel": "1.0.35",
    "@ai-sdk/provider": "4.0.3",
    "@ai-sdk/provider-utils": "5.0.12",
    "@ai-sdk/test-server": "2.0.0",
    "@arethetypeswrong/cli": "^0.18.2",
    "@langfuse/otel": "^5.5.3",
    "@langfuse/tracing": "^5.5.3",
    "@langfuse/vercel-ai-sdk": "5.5.0-beta.3",
    "@opentelemetry/api": "1.9.0",
    "@opentelemetry/context-async-hooks": "^2.7.1",
    "@opentelemetry/sdk-node": "^0.218.0",
    "@opentelemetry/sdk-trace-base": "^2.7.1",
    "@total-typescript/tsconfig": "^1.0.4",
    "@types/node": "^25.0.10",
    "@vitest/coverage-v8": "4.0.18",
    "ai": "7.0.35",
    "ai-test-kit": "3.3.1",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "msw": "^2.12.7",
    "oxfmt": "^0.45.0",
    "oxlint": "^1.60.0",
    "pkg-pr-new": "^0.0.62",
    "publint": "^0.3.17",
    "tsdown": "^0.20.1",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vitest": "^4.0.18",
    "zod": "^4.3.6"
  },
  "peerDependencies": {
    "@ai-sdk/provider": "^4.0.0",
    "@ai-sdk/provider-utils": "^5.0.0",
    "@opentelemetry/api": "^1.9.0",
    "ai": "^7.0.0",
    "zod": "^4.0.0"
  },
  "peerDependenciesMeta": {
    "@opentelemetry/api": {
      "optional": true
    }
  },
  "lint-staged": {
    "*.{js,ts,tsx,jsx}": [
      "pnpm lint",
      "pnpm format"
    ],
    "*.{json,jsonc}": [
      "pnpm format"
    ]
  },
  "packageManager": "pnpm@10.0.0"
}
